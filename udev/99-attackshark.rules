# Attack Shark peripherals: let the logged-in user talk to
# the hidraw nodes. Written by "attackshark permissions install";
# regenerating it is safe, local edits are overwritten.
#
# Rules match the vendor id, not a single product id, so a new
# model of the same family works without a new rules file.

# Royuan keyboards: R85 HE and relatives
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3151", TAG+="uaccess", MODE="0660"

# Compx mice: R11 Ultra, X11 Ultra and relatives
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", TAG+="uaccess", MODE="0660"
